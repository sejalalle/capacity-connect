# --- Dependencies ---
node_modules/

# --- Build output ---
dist/
build/

# --- Environment files (never commit real secrets) ---
.env
.env.*
!.env.example

# --- Test / tooling output ---
coverage/
test-results/
playwright-report/
artifacts/
blob-report/
.playwright/

# --- Local MongoDB data directory ---
# The README runs `mongod --dbpath ./data`. WiredTiger stores every collection
# and index as a binary .wt file here, plus its journal and diagnostics. This is
# local-only database state and must never be committed.
data/
*.wt
WiredTiger.lock
WiredTiger.turtle
WiredTigerHS.wt
_mdb_catalog.wt
sizeStorer.wt
storage.bson
mongod.lock
diagnostic.data/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- OS / editor noise ---
.DS_Store
Thumbs.db
*.swp
