# Transactions used for admissions and decisions require a replica set.
MONGO_URI=mongodb://127.0.0.1:27017/samarthya?replicaSet=rs0
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=8h
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
ADMIN_SEED_EMAIL=admin@example.test
ADMIN_SEED_PASSWORD=admin1234
NODE_ENV=development
DEMO_REFERENCE_DATE=2026-10-01T00:00:00.000Z

# Optional AI assistance. Core evidence and competency workflows work when disabled.
AI_ENABLED=false
AI_PROVIDER=disabled
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=10000
AI_RETRY_LIMIT=1
AI_REQUEST_LIMIT=20
AI_EXTERNAL_DATA_APPROVED=false
CAPABILITY_EVIDENCE_THRESHOLD_PERCENT=70
