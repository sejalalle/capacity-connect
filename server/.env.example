# Transactions used for admissions and decisions require a replica set.
MONGO_URI=mongodb://127.0.0.1:27017/samarthya?replicaSet=rs0
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=8h
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
ADMIN_SEED_EMAIL=admin@example.test
ADMIN_SEED_PASSWORD=admin1234
NODE_ENV=development
DEMO_REFERENCE_DATE=2026-10-01T00:00:00.000Z

# ── Optional AI assistance ───────────────────────────────────────────────────
# AI is an assistance layer, never the decision layer. Competency levels,
# grading, practical verification, certificate issuance, admin approval and
# final Train-the-Trainer verification are always human decisions. Core evidence
# and competency workflows work with AI switched off. See docs/ai-position.md.
#
# Change ONE switch, then restart the backend. Every AI-assisted task moves with
# it: MCQ drafting, skill-gap explanation, course-recommendation explanation,
# trainer-match explanation, evidence summarization, feedback summarization and
# Train-the-Trainer candidate summarization.
#   disabled : no AI calls. Safe default.
#   gemini   : Google Gemini for every AI-assisted task.
#   openai   : OpenAI for every AI-assisted task.
#   mock     : deterministic fixtures. Tests only; refused outside NODE_ENV=test.
#
# There is no automatic fallback between providers. A profile either works or the
# call fails closed to the manual workflow.
AI_PROVIDER_PROFILE=disabled

# Google Gemini (used when AI_PROVIDER_PROFILE=gemini).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI (used when AI_PROVIDER_PROFILE=openai).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# External AI calls stay blocked until this is explicitly approved for the
# environment. Selecting gemini or openai is not by itself a data-handling
# approval. The mock profile does not need it.
AI_EXTERNAL_DATA_APPROVED=false

# Optional hard off. Leave unset: AI_PROVIDER_PROFILE=disabled is the normal way
# to switch AI off. Setting false here wins over any profile.
# AI_ENABLED=false

AI_TIMEOUT_MS=10000
AI_RETRY_LIMIT=1
AI_REQUEST_LIMIT=20

# Manual overrides. Leave blank to use the selected profile's defaults.
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=

CAPABILITY_EVIDENCE_THRESHOLD_PERCENT=70